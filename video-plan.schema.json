{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-video.local/video-plan.schema.json",
  "title": "Knowledge Video Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "language", "width", "height", "fps", "durationSeconds", "voice", "scenes"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "language": { "const": "zh-CN" },
    "width": { "const": 1080 },
    "height": { "const": 1920 },
    "fps": { "const": 30 },
    "durationSeconds": { "type": "number", "minimum": 1, "maximum": 180 },
    "voice": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "voiceId", "text"],
      "properties": {
        "provider": { "enum": ["edge-tts", "mock", "macos-say"] },
        "voiceId": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1, "maxLength": 12000 }
      }
    },
    "scenes": {
      "type": "array", "minItems": 1, "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "startSeconds", "durationSeconds", "narration", "visualType", "visual", "caption"],
        "properties": {
          "id": { "type": "string", "pattern": "^scene-[0-9]{2}$" },
          "startSeconds": { "type": "number", "minimum": 0 },
          "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
          "narration": { "type": "string", "minLength": 1, "maxLength": 500 },
          "visualType": { "enum": ["talking_text", "number", "comparison", "flow", "image_broll", "quote"] },
          "visual": {
            "type": "object", "additionalProperties": false,
            "required": ["headline", "accent", "items"],
            "properties": {
              "headline": { "type": "string", "minLength": 1, "maxLength": 80 },
              "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
              "items": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 80 } },
              "metric": { "type": "number" },
              "unit": { "type": "string", "maxLength": 12 },
              "leftLabel": { "type": "string", "maxLength": 40 },
              "rightLabel": { "type": "string", "maxLength": 40 },
              "imageQuery": { "type": "string", "maxLength": 120 }
            }
          },
          "caption": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    }
  }
}
